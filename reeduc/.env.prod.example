# --- Django production ---
DJANGO_SETTINGS_MODULE=reeduc.settings_prod
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_FOR_A_LONG_RANDOM_SECRET_WITH_32_PLUS_CHARS
DJANGO_ALLOWED_HOSTS=10.0.125.4,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://10.0.125.4,http://10.0.125.4:8000
ENABLE_HTTPS=False

# --- Database (PostgreSQL in docker-compose) ---
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=reeducdb
DB_USER=sejus
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# --- Default admin bootstrap (optional) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEFAULT_ADMIN_EMAIL=admin@example.com

# --- App port inside container ---
PORT=8000
