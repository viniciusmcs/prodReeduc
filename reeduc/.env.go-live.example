# --- Django production ---
DJANGO_SETTINGS_MODULE=reeduc.settings_prod
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_WITH_STRONG_RANDOM_32_PLUS_CHARS
DJANGO_ALLOWED_HOSTS=10.0.125.4
CSRF_TRUSTED_ORIGINS=https://10.0.125.4:8443,http://10.0.125.4:8000
ENABLE_HTTPS=True

# --- PostgreSQL (docker service: db) ---
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=reeducdb
DB_USER=sejus
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

# --- Admin bootstrap (recommended empty in final go-live) ---
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=

# --- App port inside web container ---
PORT=8000
